# Copy these settings into server/.env.
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=1d
DB_HOST=localhost
DB_PORT=3306
DB_NAME=api
DB_USER=root
DB_PASS=
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
